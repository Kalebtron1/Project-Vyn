# ─────────────────────────────────────────────────────────────
# Project Vyn — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (PUBLIC — safe to expose in the browser) ────────
# Project ID shown in Supabase dashboard → Project Settings → General
VITE_SUPABASE_PROJECT_ID=""

# Project URL shown in Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=""

# "anon / public" key from Supabase dashboard → Project Settings → API
# This key is embedded in the frontend bundle; it is not a secret.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── Stellar admin account (SECRET — never expose publicly) ───
# Public key of the backend admin account used to sign contract calls.
# Must match the account whose secret is in SECRET_KEY_ADMIN.
PUBLIC_KEY_ADMIN=""

# Secret key of the backend admin account.
# Used by serverless functions to sign mint and tier-check transactions.
# ⚠️  Keep this out of version control and CI logs.
SECRET_KEY_ADMIN=""

# ── Soroban contract IDs (PUBLIC — not sensitive) ────────────
# Contract ID of the vinculo_sbt (SBT/NFT) contract on Stellar Testnet.
# Update this value whenever the contract is redeployed.
NFT_CONTRACT_ID=""

# Contract ID of the vinculo_lending contract on Stellar Testnet.
# Prefixed with VITE_ so the frontend can read it directly.
VITE_LENDING_CONTRACT_ID=""

# ── Local development ─────────────────────────────────────────
# Port for the local Express backend (backend/server.js).
# Defaults to 3000 if not set.
PORT=3000

# ── Managed by Vercel (do not set manually) ──────────────────
# Injected automatically by Vercel OIDC during CI/CD workflows.
# Not required for local development.
# VERCEL_OIDC_TOKEN=""
