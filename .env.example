# ─────────────────────────────────────────────────────────────
# Project Vyn — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Stellar admin account (SECRET — never expose publicly) ───
# Public key of the backend admin account used to sign contract calls.
# Must match the account whose secret is in SECRET_KEY_ADMIN.
PUBLIC_KEY_ADMIN=""

# Secret key of the backend admin account.
# Used by serverless functions to sign mint and tier-check transactions.
# ⚠️  Keep this out of version control and CI logs.
SECRET_KEY_ADMIN=""

# ── Soroban contract IDs (PUBLIC — not sensitive) ────────────
# Contract ID of the vinculo_sbt (SBT/NFT) contract on Stellar Testnet.
# Update this value whenever the contract is redeployed.
NFT_CONTRACT_ID=""

# Contract ID of the vinculo_lending contract on Stellar Testnet.
# Prefixed with VITE_ so the frontend can read it directly.
VITE_LENDING_CONTRACT_ID=""

# Contract ID of the staking_pool (DeFindex-backed) contract on Stellar Testnet.
# There is no hardcoded fallback: both variables must be set to the SAME id.
# - VITE_ prefix → read by the frontend (src/stellar/contracts.ts).
# - STAKING_CONTRACT_ID → read by the serverless API functions.
# Update both whenever the contract is redeployed.
VITE_STAKING_CONTRACT_ID=""
STAKING_CONTRACT_ID=""

# Treasury wallet (G... address). The only wallet that can SEE and OPERATE the
# treasury panel (interest profit from loans). UI gating is cosmetic; the real
# authorization is enforced on-chain by vinculo_lending's withdraw_interest.
VITE_TREASURY_ADDRESS=""

# ── BlindPay (off-ramp SPEI) — SECRETS, backend only ─────────
# REST API base + credenciales de la instancia (dashboard app.blindpay.com).
# La API key NUNCA debe ir en el bundle Vite (sin prefijo VITE_).
BLINDPAY_BASE_URL="https://api.blindpay.com/v1"
BLINDPAY_API_KEY=""
BLINDPAY_INSTANCE_ID=""
# Secret para verificar la firma de los webhooks de BlindPay.
BLINDPAY_WEBHOOK_SECRET=""

# Wallet de payout dedicada (G... + S...). Firma el `approve` del token y envía el payout.
# Mantener el secret fuera de control de versiones.
BLINDPAY_PAYOUT_PUBLIC=""
BLINDPAY_PAYOUT_SECRET=""

# Demo "Simular KYC" (sandbox): receiver + cuenta SPEI ya aprobados para saltar onboarding.
BLINDPAY_DEMO_RECEIVER_ID=""
BLINDPAY_DEMO_BANK_ACCOUNT_ID=""

# ── Local development ─────────────────────────────────────────
# Port for the local Express backend (backend/server.js).
# Defaults to 3000 if not set.
PORT=3000

# ── Managed by Vercel (do not set manually) ──────────────────
# Injected automatically by Vercel OIDC during CI/CD workflows.
# Not required for local development.
# VERCEL_OIDC_TOKEN=""
